# Both variables are created automatically when you add Neon through the Vercel Marketplace.
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection used by Prisma for schema pushes.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Any long random string. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me"
